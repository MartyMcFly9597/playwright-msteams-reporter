{
  "name": "@martymcfly9597/playwright-msteams-reporter",
  "version": "0.5.0",
  "description": "Microsoft Teams reporter for Playwright which allows you to send notifications about the status of your E2E tests.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./healthReporter": {
      "import": {
        "types": "./dist/esm/healthReporter.d.mts",
        "default": "./dist/esm/healthReporter.mjs"
      },
      "require": {
        "types": "./dist/healthReporter.d.ts",
        "default": "./dist/healthReporter.js"
      },
      "default": "./dist/healthReporter.js"
    },
    "./healthCapture": {
      "types": "./dist/healthCapture.d.ts",
      "require": "./dist/healthCapture.js",
      "default": "./dist/healthCapture.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "require": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc && node scripts/build-esm-wrappers.cjs",
    "prepack": "npm run build",
    "watch": "tsc -w",
    "test": "NODE_ENV=development npx playwright test",
    "test:jest": "jest --coverage --coverageDirectory=../coverage",
    "test:package": "node scripts/test-packaged-artifact.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartyMcFly9597/playwright-msteams-reporter.git"
  },
  "keywords": [
    "playwright",
    "msteams",
    "Microsoft",
    "Teams",
    "e2e",
    "testing"
  ],
  "author": "MartyMcFly9597",
  "contributors": [
    {
      "name": "Elio Struyf",
      "url": "https://github.com/estruyf"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MartyMcFly9597/playwright-msteams-reporter/issues"
  },
  "homepage": "https://github.com/MartyMcFly9597/playwright-msteams-reporter#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.3",
    "dotenv": "^17.4.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.45.0"
  }
}
